# Copy to .env (make setup does this). Never commit .env or .env.local.

# --- Mock sites (test-only logins; they work nowhere else) ---
MOCK_PORT=8100
MOCK_BANK_USER=margaret
MOCK_BANK_PASS=maple-test-only
MOCK_MAIL_USER=margaret
MOCK_MAIL_PASS=postbox-test-only

# --- Encrypted login vault (make vault fills this in) ---
LEND_VAULT_KEY=

# --- Models, via LiveKit Inference (billed to your LiveKit project) ---
LEND_PLANNER=grok
LEND_GROK_MODEL=xai/grok-4.3
LEND_VOICE_LLM=xai/grok-4.3
LEND_VISION_MODEL=google/gemini-3.8-flash

# --- People (numbers verified on your Chert project) ---
USER_PHONE=
CAREGIVER_PHONE=

# --- Chert: mock prints calls and messages; live needs a project API key ---
CHERT_MODE=mock
CHERT_API_KEY=
CHERT_PROJECT_ID=
CHERT_LINE_ID=

# --- Account watch: seconds between automatic checks (0 = off) ---
AUDIT_INTERVAL_S=0

# --- Put these in .env.local (used by the agent and by `chert dev`) ---
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# AGENT_NAME=

# --- Voice: grok-voice (Grok Voice speech-to-speech) or pipeline (STT -> Grok -> TTS) ---
LEND_VOICE_MODE=grok-voice
LEND_GROK_VOICE=eve

# --- Owner check: both (face + voice must match the enrolled owner) or off ---
LEND_VERIFY=both

# --- Optional: real-human video avatar (anam.ai free plan). Put these in .env.local ---
# ANAM_API_KEY=
# ANAM_AVATAR_ID=
